{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ESNext", "DOM"],
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "sourceMap": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noEmit": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "outDir": "dist",
    "declaration": true,
    "declarationDir": "types",
    "emitDeclarationOnly": true,
    "composite": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["src/comparison/liveComparison.test.ts"],
  "references": [
    {
      "path": "../core"
    },
    {
      "path": "../react"
    },
    {
      "path": "../xl-ai"
    }
  ]
}
