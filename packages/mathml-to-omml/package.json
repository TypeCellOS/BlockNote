{
  "name": "@blocknote/mathml-to-omml",
  "homepage": "https://github.com/TypeCellOS/BlockNote",
  "private": false,
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TypeCellOS/BlockNote.git",
    "directory": "packages/mathml-to-omml"
  },
  "license": "MPL-2.0",
  "version": "0.53.0",
  "files": [
    "dist",
    "types",
    "src"
  ],
  "keywords": [
    "mathml",
    "omml",
    "docx",
    "word",
    "ooxml",
    "math",
    "katex",
    "converter"
  ],
  "description": "Converts MathML to Office Math Markup Language (OMML), targeting the MathML dialect emitted by KaTeX. Clean-room implementation from the MathML and ECMA-376 specifications.",
  "type": "module",
  "source": "src/index.ts",
  "types": "./types/src/index.d.ts",
  "main": "./dist/blocknote-mathml-to-omml.cjs",
  "module": "./dist/blocknote-mathml-to-omml.js",
  "exports": {
    ".": {
      "types": "./types/src/index.d.ts",
      "import": "./dist/blocknote-mathml-to-omml.js",
      "require": "./dist/blocknote-mathml-to-omml.cjs"
    }
  },
  "scripts": {
    "dev": "vp dev",
    "lint": "vp lint src",
    "test": "vp test --run",
    "test-watch": "vp test watch",
    "clean": "rimraf dist && rimraf types"
  },
  "dependencies": {
    "fast-xml-parser": "^5.10.1"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^25.6.0",
    "katex": "^0.16.11",
    "rimraf": "^5.0.10",
    "rollup-plugin-webpack-stats": "^0.2.6",
    "typescript": "^5.9.3",
    "vite-plus": "catalog:",
    "xml-formatter": "^3.6.7"
  }
}
