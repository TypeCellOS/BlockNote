// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`merged table cells preserve row and column header roles > merged table 1`] = `
"- textbox:
  - table:
    - rowgroup:
      - row "Region Apples Pears":
        - columnheader "Region":
          - paragraph: Region
