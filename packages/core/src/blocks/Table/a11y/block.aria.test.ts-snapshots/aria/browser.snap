          - paragraph: Apples
        - columnheader "Pears":
          - paragraph: Pears
      - row "North Combined total":
        - rowheader "North":
          - paragraph: North
        - cell "Combined total":
          - paragraph: Combined total
      - row "South":
        - rowheader "South":
          - paragraph: South"
`;
