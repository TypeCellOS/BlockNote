{
  "name": "@blocknote/xl-ai-server",
  "homepage": "https://github.com/TypeCellOS/BlockNote",
  "private": true,
  "sideEffects": [
    "./src/index.ts",
    "./dist/blocknote-xl-ai-server.js"
  ],
  "license": "GPL-3.0 OR PROPRIETARY",
  "version": "0.56.0",
  "files": [
    "dist",
    "types",
    "src",
    "!**/*.cjs",
    "!**/*.map",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/*.snap",
    "!**/__test__/**",
    "!**/__tests__/**",
    "!**/tests/**",
    "!**/__snapshots__/**",
    "!**/__msw_snapshots__/**",
    "!**/fixtures/**",
    "!**/testUtil/**",
    "!**/testUtils/**",
    "!**/test-utils/**",
    "!**/*.tsbuildinfo",
    "!dist/webpack-stats.json"
  ],
  "keywords": [
    "react",
    "javascript",
    "editor",
    "typescript",
    "prosemirror",
    "wysiwyg",
    "rich-text-editor",
    "notion",
    "yjs",
    "block-based",
    "tiptap"
  ],
  "description": "A \"Notion-style\" block-based extensible text editor built on top of Prosemirror and Tiptap.",
  "type": "module",
  "source": "src/index.ts",
  "types": "./types/src/index.d.ts",
  "main": "./dist/blocknote-xl-ai-server.js",
  "module": "./dist/blocknote-xl-ai-server.js",
  "exports": {
    ".": {
      "types": "./types/src/index.d.ts",
      "import": "./dist/blocknote-xl-ai-server.js",
      "default": "./dist/blocknote-xl-ai-server.js"
    }
  },
  "scripts": {
    "dev": "vite-node src/index.ts",
    "start": "node dist/blocknote-xl-ai-server.js",
    "lint": "vp lint src",
    "clean": "rimraf dist && rimraf types"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.88",
    "@ai-sdk/google": "^4.0.105",
    "@ai-sdk/groq": "^4.0.70",
    "@ai-sdk/mistral": "^4.0.72",
    "@ai-sdk/openai": "^4.0.102",
    "@ai-sdk/openai-compatible": "^3.0.78",
    "@blocknote/xl-ai": "workspace:^",
    "@hono/node-server": "^1.19.5",
    "ai": "^7.0.153",
    "hono": "^4.10.3"
  },
  "devDependencies": {
    "@types/node": "22.13.13",
    "rimraf": "^5.0.10",
    "rollup-plugin-webpack-stats": "^0.2.6",
    "typescript": "^7.0.2",
    "undici": "^6.22.0",
    "vite-node": "^6.0.0",
    "vite-plugin-externalize-deps": "^0.10.0",
    "vite-plus": "catalog:"
  }
}
