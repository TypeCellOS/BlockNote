# Only send inputs consumed by tests/Dockerfile. Keep workspace manifest paths
# and generated-directory exclusions in sync with tests/docker-image-inputs.sh.
**
!pnpm-lock.yaml
!pnpm-workspace.yaml
!package.json
!packages/*/package.json
!examples/**
!playground/package.json
!fumadocs/package.json
!docs/package.json
!shared/package.json
!tests/package.json
!patches/**
!tests/Dockerfile

# Never include host dependencies or generated output from example apps.
**/node_modules
**/dist
**/types
**/pkg
**/.next
**/.vite
**/.vite-plus
**/*.tsbuildinfo
**/.DS_Store
**/test-results
**/blob-report
**/playwright-report
**/.vitest-attachments
**/rust/target
